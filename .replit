modules = ["nodejs-24", "python-3.12"]

[deployment]
router = "application"
deploymentTarget = "vm"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "browser-regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "python-regression"

[[workflows.workflow]]
name = "browser-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/masar-al-adl run test:browser"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "python-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/masar-al-adl run test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales"]

[userenv]

[userenv.development]
MASAR_PDF_BUCKET_ID = "replit-objstore-3a3e9c88-9320-4bc8-b819-15bdeede409f"
PDF_STORAGE_BACKEND = "app_storage"

[userenv.production]
DATA_MODE = "demo"
MASAR_PDF_BUCKET_ID = "replit-objstore-3a3e9c88-9320-4bc8-b819-15bdeede409f"
PDF_STORAGE_BACKEND = "app_storage"
SECURE_COOKIES = "true"
